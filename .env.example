# Run `phobos init` to generate .env with a random owner token.
PHOBOS_API_TOKEN=
PHOBOS_HOST=127.0.0.1
PHOBOS_PORT=8080
PHOBOS_DATA_DIR=./data
PHOBOS_WORKSPACE_DIR=./workspace
# All inference uses a LiteLLM or OpenAI-compatible gateway you control.
PHOBOS_GATEWAY_URL=http://127.0.0.1:4000/v1
# Compose uses this endpoint instead of host-loopback above.
PHOBOS_DOCKER_GATEWAY_URL=http://llm-gateway:4000/v1
PHOBOS_GATEWAY_KEY=
PHOBOS_MODEL=
# Optional Telegram profile; numeric owner IDs, comma separated.
PHOBOS_TELEGRAM_TOKEN=
PHOBOS_TELEGRAM_USERS=
PHOBOS_TELEGRAM_CHANNEL=
PHOBOS_TELEGRAM_PROJECT=personal
PHOBOS_REPORT_HOUR_UTC=18


# Original service settings (all profiles optional).
# Ported agent-service configuration
# ==========================================================
# Services: hermes, llm-gateway
# Optional profiles: design, dsh, terrain

# ── 1. CORE — REQUIRED TO START ────────────────────────────
# Path on host to the directory containing your codebases.
# Can be a relative path (e.g. ./workspace) or an absolute path.
# IMPORTANT: This directory MUST already exist on your host machine before starting!
# Mounted read-write at /opt/data/workspace in hermes (Hermes can edit project files;
# code intelligence indexes and the research vault lives here too).
WORKSPACE_DIR=./workspace

# ── BIND IPs (per-service) ──────────────────────────────────
# Each service binds independently. Default = 127.0.0.1 (private host access).
# Set to 127.0.0.1 for loopback-only (more secure).
#   HERMES_BIND_IP       — Hermes dashboard + API (ports 9119, 8642)
#   LLM_GATEWAY_BIND_IP  — LiteLLM gateway (port 4000, holds ALL provider keys)
#   OPEN_DESIGN_BIND_IP  — OpenDesign UI (port 7456, design profile)
#   DSH_BIND_IP          — DeepSeek Harness (port 9229, dsh profile)
#   TERRAIN_BIND_IP      — Terrain shim (port 7878, terrain profile)
HERMES_BIND_IP="127.0.0.1"
LLM_GATEWAY_BIND_IP="127.0.0.1"
OPEN_DESIGN_BIND_IP="127.0.0.1"
DSH_BIND_IP="127.0.0.1"
TERRAIN_BIND_IP="127.0.0.1"

# ── 2. LLM GATEWAY (llm-gateway:4000) — All model routing ────
# LiteLLM (llm-gateway:4000) handles all model management for the entire stack.
# Downstream (Hermes) simply requests "default" from LiteLLM, with zero
# dependency on specific model configurations.
#
# Connect LiteLLM to ANY OpenAI-compatible provider:
# • Local / self-hosted: LM Studio, Ollama, llama.cpp, vLLM, LocalAI, Jan, text-gen-webui
# • Remote / network node: GPU workstation, Tailscale machine, or remote vLLM/Ollama
# • Cloud provider with OpenAI-compatible API (Groq, Together, DeepInfra, OpenAI, etc.)
#
# Examples:
# • LM Studio on host: "http://host.docker.internal:1234/v1"
# • Ollama on host:    "http://host.docker.internal:11434/v1"
# • llama.cpp on host: "http://host.docker.internal:8080/v1"
# • Remote / LAN node: "http://office2:1234/v1" or "http://100.x.y.z:8080/v1"
OPENAI_COMPATIBLE_BASE_URL="http://host.docker.internal:8080/v1"

# Optional upstream model identifier (defaults to "default" if omitted or left empty)
# Many servers (like LM Studio or llama.cpp) will automatically use their loaded model.
OPENAI_COMPATIBLE_MODEL="default"

# Optional API key / bearer token for your upstream OpenAI-compatible provider
# (e.g. "not-needed" for local Ollama/LM Studio/llama.cpp; bearer token if upstream requires auth)
OPENAI_COMPATIBLE_API_KEY="not-needed"

# Cloud provider keys for LiteLLM routing & automatic fallback chains:
OPENROUTER_API_KEY=""
KILO_GATEWAY_API_KEY=""
MISTRAL_API_KEY=""
GEMINI_API_KEY=""
LLM7_API_KEY=""
NVIDIA_API_KEY=""
OLLAMA_CLOUD_API_KEY=""
AION_LABS_API_KEY=""

# Optional LiteLLM Master Key (leave commented out for unauthenticated local gateway).
# WARNING: an active-but-empty value (LITELLM_MASTER_KEY="") is treated as SET by
# LiteLLM: it enforces key auth with no database attached and every request fails
# with HTTP 400 "No connected db". Only uncomment with a real value.
# LITELLM_MASTER_KEY=""

# ── 3. LANGFUSE TELEMETRY ────────────────────────────────────
# Enable Langfuse tracing for LiteLLM
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# ── 4. HERMES AUTH ───────────────────────────────────────────
# How to choose / generate each secret:
#
# • HERMES_DASHBOARD_BASIC_AUTH_USERNAME:
#   Username for HTTP Basic Auth to Hermes Dashboard (:9119 / :8642).
#   Char limits: Typically 3-32 alphanumeric characters (default: admin).
#
# • HERMES_DASHBOARD_BASIC_AUTH_PASSWORD:
#   Password for Dashboard login (hashed via scrypt inside container).
#   Char limits: Recommended min 8-12+ characters for security.
#   Generate: openssl rand -hex 12
#
# • HERMES_DASHBOARD_BASIC_AUTH_SECRET:
#   Cryptographic secret used for dashboard session cookie encryption & signing.
#   Char limits: Minimum 32 characters; 64 hex characters (32 bytes) strongly recommended.
#   Generate: openssl rand -hex 32
#
# • API_SERVER_KEY:
#   Bearer token for authenticating REST API requests to Hermes gateway server.
#   Char limits: Minimum 32 characters; 64 hex characters (32 bytes) recommended.
#   Generate: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="admin123"
HERMES_DASHBOARD_BASIC_AUTH_SECRET="changeme-auth-secret-32-chars-min"
API_SERVER_KEY="changeme-api-server-key-32-chars"

# ── 5. PER-PROJECT RESEARCH & PLANNING (`.project/` in each repo) ──
# Each project owns its research vault and planning artifacts under `.project/`:
#   <WORKSPACE_DIR>/<project>/.project/research/  — wiki vault (SCHEMA.md, index.md, log.md, raw/, entities/, concepts/, comparisons/, queries/)
#   <WORKSPACE_DIR>/<project>/.project/planning/  — planning artifacts (task_plan.md, findings.md, progress.md)
# No global research/ at workspace root. Hermes sets EXECUTION_DIR per session.

# Mnemosyne Memory:
# Hermes uses Mnemosyne as its default local-first agent memory layer.
# Memory SQLite DBs are automatically persisted inside the hermes-data Docker volume.
# Optional overrides (defaults set in docker-compose.yaml):
# MNEMOSYNE_AUTO_SLEEP_ENABLED=true
# MNEMOSYNE_AUTO_SLEEP_THRESHOLD=30

# Container file ownership:
# Automatically detected from the invoking user (`id -u` / `id -g`) in the
# Makefile and exported to `docker compose` — no manual UID/GID needed.
# Override per-invocation if required (make-argument form, since $UID is
# readonly in most shells): `make up UID=1000 GID=1000`.

# ── 6. HERMES TELEGRAM BOT ───────────────────────────────────
# Create a bot via @BotFather (/newbot) — token looks like 123456789:ABCdef...
# Find your numeric user ID via @userinfobot (NOT your @username).
# Gateway denies everyone not allowlisted (safe default — bot has terminal access).
# Restart stack after changing these (`make restart s=hermes`).
#
# • HERMES_TELEGRAM_BOT_TOKEN: required to start the adapter. Leave empty to keep Telegram disabled.
# • HERMES_TELEGRAM_ALLOWED_USERS: comma-separated numeric IDs, e.g. "123456789,987654321". Grants DM + group access.
# • HERMES_TELEGRAM_GROUP_ALLOWED_USERS (optional): sender IDs allowed in groups/forums only (no DM access).
# • HERMES_TELEGRAM_GROUP_ALLOWED_CHATS (optional): chat IDs (e.g. "-1001234567890") where any member may interact.
# Never set GATEWAY_ALLOW_ALL_USERS=true on a bot with terminal access.
HERMES_TELEGRAM_BOT_TOKEN=""
HERMES_TELEGRAM_ALLOWED_USERS=""
HERMES_TELEGRAM_GROUP_ALLOWED_USERS=""
HERMES_TELEGRAM_GROUP_ALLOWED_CHATS=""

# ── 7. OPENDESIGN (optional `design` profile) ────────────────
# Opt-in design studio sharing ${WORKSPACE_DIR} at /workspace
# (import via UI: /workspace/<project>). Start: `make design-up`.
# Login: user `open-design` (fixed by upstream) + OD_API_TOKEN below.
# Default password is `admin` — replace with `openssl rand -hex 32` output
# for anything beyond local use.
# OPEN_DESIGN_IMAGE override: ghcr.io/nexu-io/od:<version> runs stock upstream
# (no bundled opencode; generation then needs BYOK keys).
OPEN_DESIGN_IMAGE="pai-stack-open-design:latest"
OPEN_DESIGN_PORT=7456
OD_API_TOKEN="admin123"
# Extra browser origins allowed to call /api (exact origin match,
# comma-separated, e.g. "http://192.168.1.46:7456,http://office2:7456").
# Required when browsing via LAN IP / DNS name; empty = loopback only.
OPEN_DESIGN_ALLOWED_ORIGINS=""

# ── 8. DSH (optional `dsh` profile) ──────────────────────────
# Opt-in DeepSeek Harness agent sharing ${WORKSPACE_DIR} at /opt/data/workspace
# (same container path Hermes uses, so both agents see identical filepaths).
# Start: `make dsh-up`.
# Models route through llm-gateway:4000 (pinned in compose) — no model keys here.
# Built from official @deepseek-ai/dsh npm package (custom Dockerfile).
# See docs/dsh.md for architecture details.
DSH_IMAGE="pai-stack-dsh:custom"
DSH_VERSION="0.2.0-rc.2"
DSH_PORT=9229
# Mirror OPENAI_COMPATIBLE_API_KEY above (gateway authenticates downstream with
# the same key). "not-needed" works for keyless local upstreams.
DEEPSEEK_API_KEY="not-needed"
# First-boot admin password. Empty = random 16-char password printed ONCE to
# the logs — fetch with `make dsh-password`. Set your own (min 6 chars) to skip
# the lookup. Stored 0600 in the dsh_data volume; change it after first login.
DSH_ADMIN_PASSWORD="admin123"
# Auth layer on/off. "on" (default) installs the @xgone/dsh-remote login plugin;
# "off" returns to unauthenticated LAN-direct mode (trusted networks only).
DSH_SETUP_REMOTE="on"
# Extra trusted Host values for /api when browsing via LAN IP / DNS name
# (comma-separated, e.g. "localhost,office1"). Empty = loopback only.
DSH_TRUSTED_HOSTS=""
# Docker socket access. "true" installs Docker CLI in image and mounts socket.
# "false" disables native `docker` / `docker compose` in DSH.
DSH_WITH_DOCKER_SOCKET="true"
# Base image for custom build (node:24-slim, node:24-alpine, etc.)
DSH_BASE_IMAGE="node:24-slim"
# Auth plugin (@xgone/dsh-remote) version and package name
DSH_REMOTE_PLUGIN_VERSION="0.3.5"
DSH_REMOTE_PLUGIN_NAME="@xgone/dsh-remote"
DSH_WITH_REMOTE_PLUGIN="true"
# Memory plugin (dsh-mnemon) — baked into the image, installed into the web
# profile on boot. Tools surface as mnemon_* (no upstream rename support;
# shared skills keep calling Hermes-native mnemosyne_*).
DSH_WITH_MNEMON_PLUGIN="true"
DSH_MNEMON_PLUGIN_VERSION="0.5.24"
DSH_MNEMON_PLUGIN_NAME="dsh-mnemon"
# Durable automation plugin (@michengai/dsh-automation) — cron that fires with
# no chat open, fresh session per occurrence. Pinned exact: peerDeps cover this
# DSH version explicitly (alternatives only allow <0.2.0). Baked into a joint
# seed tree in the image, installed into the web profile on boot.
DSH_WITH_AUTOMATION_PLUGIN="true"
DSH_AUTOMATION_PLUGIN_VERSION="0.1.54"
DSH_AUTOMATION_PLUGIN_NAME="@michengai/dsh-automation"
# Runtime skip for the automation seed ("false" leaves the volume untouched).
DSH_WITH_AUTOMATION="true"
# First-party Telegram plugin (in-repo dsh/plugins/dsh-pai-telegram, joint
# seed tree in the image, installed into the web profile on boot).
# Build-time gate ("false" skips the seed build, needs `make dsh-up` rebuild).
DSH_WITH_TELEGRAM_PLUGIN="true"
# Runtime skip for the telegram seed ("false" leaves the volume untouched).
DSH_WITH_TELEGRAM="true"
# Pre-seed locale preference to English (dsh-automation plugin has Chinese prompts
# hardcoded; DSH defaults to browser language with 'en' fallback). "false" skips
# seeding the locale preference; the joint tree stays available in the image.
DSH_SEED_LOCALE="true"
# DeepSeek-hosted web search (a model turn per query via api.deepseek.com).
# "true" (default) disables it: entrypoint overlay unregisters model-facing
# `web_search` (keeps local `web_fetch`/http) and DSH surfs with local
# Playwright/Chromium (dsh-pai-web) + notebook/terrain/mnemon instead.
# "false" keeps the upstream deepseek-official search provider.
DSH_DISABLE_WEB_SEARCH="true"
# Playwright library + Chromium pinned in dsh/Dockerfile (local browser
# surfing that replaces DeepSeek search). Bump deliberately — needs
# `make dsh-build && make dsh-up`. Must match dsh-pai-web's dependency.
PLAYWRIGHT_VERSION="1.49.1"
# Automation tasks (official experimental schedule bundle — ships in the image,
# enabled by appending it to the web profile bundles). "false" leaves the
# shipped composition untouched (compose-only, no rebuild).
# Default: off (use @michengai/dsh-automation for scheduled coding tasks instead).
DSH_WITH_SCHEDULE="false"
# Plugin seeds: one runtime gate per plugin ("false" drops it from the
# manifest — code stays on disk, unloaded — and never deletes installed
# files). Defaults preserve today's behavior; DSH_WITH_AUTOMATION/TELEGRAM
# already exist above. DSH_WITH_PAI_PLUGINS was previously read but never set.
DSH_WITH_AUTH="true"
DSH_WITH_MNEMON="true"
DSH_WITH_PAI_PLUGINS="true"

# ── 9. DSH TELEGRAM BOT ──────────────────────────────────────
# Separate Telegram bot for DSH (optional — leave empty to disable).
# Create via @BotFather. DSH bot is independent from Hermes bot.
DSH_TELEGRAM_BOT_TOKEN=""
DSH_TELEGRAM_ALLOWED_USERS=""
DSH_TELEGRAM_GROUP_ALLOWED_USERS=""
DSH_TELEGRAM_GROUP_ALLOWED_CHATS=""

# ── 10. TERRAIN — code intelligence (optional `terrain` profile) ──
# Terrain indexes a project repo into `.terrain/` (gitignored, per-host). It is
# the single index owner: Hermes and DSH trigger jobs, neither keeps a private
# index. See docs/terrain.md.
#
# Built from Rust source — Terrain publishes prebuilt binaries for darwin-arm64
# and win32-x64 only, so there is no Linux npm package. First build is slow
# (LTO + codegen-units=1); later builds reuse the layer cache.
#
# Pinned by git ref. Bump deliberately — .terrain/ format may change upstream.
TERRAIN_REF="main"
TERRAIN_IMAGE="pai-stack-terrain:latest"
TERRAIN_PORT=7878
# "1" enables the gateway-backed actions (`ask`, `init`). OFF by default:
# indexing (`scan`/`refresh`) never calls an LLM, so the default costs zero
# tokens. When on, calls route through llm-gateway:4000 — no new provider key.
# Set to 1 in .env to unlock Q&A; leave the template at 0 so a fresh clone
# still starts token-free.
TERRAIN_ALLOW_LLM=1
# Optional shared secret. When set, callers must send `x-terrain-token`.
# Recommended if you widen TERRAIN_BIND_IP beyond loopback.
TERRAIN_TOKEN=""
# Memory ceiling. Terrain is a short-lived batch process, not a daemon.
TERRAIN_MEM_LIMIT=2g

# ── 11. DOCKER GID (host-specific) ───────────────────────────
# GID owning /var/run/docker.sock on THIS host. `stat -c %g` reports 0 here
# (the socket is root:root, not root:docker), so without this pin the container
# would be built with the 999 fallback and every docker call inside dsh would
# fail with EACCES while the mount itself still looks correct.
# Set explicitly rather than relying on the Makefile's auto-detect, so compose
# resolves the right value however it is invoked (raw `docker compose` skips the
# Makefile's `stat` and silently falls back to 999). Baked into /etc/group at
# build time, so it needs `make dsh-up` (which rebuilds) to take effect.
DOCKER_GID=0

# Phobos learning and procedural knowledge
PHOBOS_GRAPH_MEMORY=true
PHOBOS_SKILL_AUTO_INSTALL=true
PHOBOS_SKILL_SOURCES=morluto/rea,alchaincyf/huashu-motion,anthropics/skills,vercel-labs/agent-skills,openai/skills
# Host directory mounted read-only under /models in the creative worker
PHOBOS_MODEL_DIR=./models
# Native local CLI/worker: provision a faster-whisper model here before transcription
PHOBOS_TRANSCRIPTION_MODEL_DIR=./models/whisper
